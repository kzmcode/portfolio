{
  "name": "portfolio",
  "type": "module",
  "private": true,
  "scripts": {
    "types": "wrangler types",
    "dev": "wrangler types && astro dev",
    "build": "wrangler types && astro build",
    "preview": "astro preview",
    "check": "wrangler types && astro check && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "env -u CLOUDFLARE_API_TOKEN wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm build && env -u CLOUDFLARE_API_TOKEN wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "astro": "^7.4.2",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.152.0",
    "yaml": "2.9.1"
  }
}
