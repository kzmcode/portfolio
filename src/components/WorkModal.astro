---
import type { WorkView } from '../lib/works';
import DeviceFrame from './DeviceFrame.astro';
import ArrowIcon from './ArrowIcon.astro';
import SnsIcon from './SnsIcon.astro';
interface Props { works: WorkView[] }
const { works } = Astro.props;
---
<div class="work-modal" id="work-modal" hidden>
  <button type="button" class="scrim" tabindex="-1" aria-label="プレビューを閉じる" data-close></button>
  <div class="dialog" role="dialog" aria-modal="true" aria-label="作品のプレビュー" tabindex="-1">
    <button type="button" class="close" aria-label="閉じる" data-close>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13"></path></svg>
    </button>
    <div class="info">
      <div class="info-head">
        <span class="m-meta" data-slot="meta"></span>
        <h3 class="m-title" data-slot="title"></h3>
      </div>
      <div class="m-desc">
        <p class="m-desc-en" lang="en" data-slot="description-en"></p>
        <p class="m-desc-ja" data-slot="description"></p>
      </div>
      <dl class="m-dl">
        <div><dt>PLATFORM</dt><dd data-slot="platform"></dd></div>
        <div><dt>TOOLS</dt><dd data-slot="tools"></dd></div>
        <div><dt>DATE</dt><dd data-slot="date"></dd></div>
      </dl>
      <div class="m-actions">
        <div class="m-links">
          <a class="btn-primary visit" data-slot="visit" target="_blank" rel="noopener noreferrer">VISIT <ArrowIcon size={14} stroke={1.8} /><span class="visually-hidden">（新しいタブで開きます）</span></a>
          <a class="btn-primary repo" data-slot="repo" target="_blank" rel="noopener noreferrer"><SnsIcon icon="github" size={16} />GITHUB<span class="visually-hidden">（新しいタブで開きます）</span></a>
        </div>
        <div class="pager">
          <button type="button" class="btn-line" aria-label="前の作品" data-prev>←</button>
          <button type="button" class="btn-line" aria-label="次の作品" data-next>→</button>
        </div>
      </div>
    </div>
    <div class="preview">
      <DeviceFrame />
    </div>
  </div>
</div>
<script type="application/json" id="works-data" set:html={JSON.stringify(works).replace(/</g, '\\u003c')} />

<style>
  .work-modal { position: fixed; inset: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 24px; }
  .scrim { position: absolute; inset: 0; border: 0; padding: 0; background: var(--scrim); cursor: pointer; }
  .dialog {
    position: relative; width: 100%; max-width: 1240px; max-height: calc(100vh - 48px); max-height: calc(100dvh - 48px); overflow-y: auto;
    background: var(--bg); display: flex; flex-wrap: wrap;
    animation: modal-in .28s var(--ease-out);
  }
  .dialog:focus { outline: none; }
  @keyframes modal-in { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .work-modal.closing .dialog { animation: modal-out .2s ease-in forwards; }
  .work-modal.closing .scrim { animation: fade-out .2s ease-in forwards; }
  .scrim { animation: fade-in .28s ease-out; }
  @keyframes modal-out { to { opacity: 0; transform: translateY(12px); } }
  @keyframes fade-in { from { opacity: 0; } }
  @keyframes fade-out { to { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .dialog, .scrim, .work-modal.closing .dialog, .work-modal.closing .scrim { animation: none; } }

  .close { position: absolute; z-index: 2; top: 20px; right: 20px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--line); background: var(--bg); color: var(--text); }
  /* 閉じる・前後ボタン：hover / focus で濃色に塗りつぶす */
  .close, .pager .btn-line { transition: background-color .2s, color .2s, border-color .2s; }
  .close:hover, .close:focus-visible, .pager .btn-line:hover, .pager .btn-line:focus-visible { background: var(--text); color: var(--bg); border-color: var(--text); }
  .info { flex: 1 1 340px; min-width: 0; padding: 48px clamp(24px, 3.5vw, 48px); display: flex; flex-direction: column; gap: 32px; }
  .info-head { display: flex; flex-direction: column; gap: 16px; }
  .m-meta { font-size: 15px; letter-spacing: .04em; color: var(--text-2); }
  .m-title { font-size: 32px; font-weight: 700; line-height: 1.3; padding-right: 48px; }
  .m-desc { display: flex; flex-direction: column; gap: 14px; white-space: pre-line; }
  .m-desc-en { font-family: var(--font-display); font-size: 16px; line-height: 1.9; letter-spacing: .02em; }
  .m-desc-ja { font-size: 15px; line-height: 2; color: var(--text-2); }
  .m-dl { display: flex; flex-direction: column; gap: 6px; }
  .m-dl div { display: flex; gap: 24px; padding: 2px 0; }
  .m-dl dt { flex: 0 0 96px; font-family: var(--font-display); font-size: 12px; letter-spacing: .2em; color: var(--text-2); padding-top: 2px; }
  .m-dl dd { font-size: 14px; min-width: 0; overflow-wrap: anywhere; }
  .m-actions { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; }
  .m-links { display: flex; flex-wrap: wrap; gap: 8px; }
  /* VISIT / GITHUB は白抜き → hover で濃色ベタ */
  .visit, .repo {
    min-height: 44px; padding: 0 20px; font-size: 12px; letter-spacing: .2em; gap: 10px;
    background: var(--field); color: var(--text); box-shadow: inset 0 0 0 1.5px var(--text); transition: background-color .2s, color .2s;
  }
  .visit:hover, .visit:focus-visible, .repo:hover, .repo:focus-visible { background: var(--text); color: var(--bg); }
  .pager { display: flex; gap: 8px; margin-left: auto; }
  .pager .btn-line { padding: 0; width: 44px; font-size: 16px; letter-spacing: 0; }
  .preview { flex: 1.7 1 480px; min-width: 0; min-height: 680px; display: flex; align-items: center; justify-content: center; padding: 88px 48px 48px 16px; }
  @media (max-width: 900px) {
    .info, .preview { flex-basis: 100%; }
    .preview { min-height: 0; padding: 0 24px 48px; }
  }
  @media (max-width: 600px) { .work-modal { padding: 0; } .dialog { max-height: 100dvh; height: 100%; } }
</style>

<script>
  import { initWorkModal } from '../scripts/modal';
  initWorkModal();
</script>
