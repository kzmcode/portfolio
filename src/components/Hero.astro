---
import { site } from '../content/site';
import SnsIcon from './SnsIcon.astro';
---
<section id="top" class="hero" aria-label="イントロダクション">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-text">
    <h1 class="hero-name"><span class="first">{site.name}'s</span> portfolio</h1>
    <a class="hero-cta" href="#work">VIEW WORK</a>
    <ul class="hero-sns">
      {site.sns.map((s) => (
        <li><a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`${s.label}（新しいタブで開きます）`}><SnsIcon icon={s.icon} /></a></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; height: clamp(640px, 100svh, 900px);
    background: var(--surface); display: flex; align-items: center; justify-content: center; cursor: crosshair;
    touch-action: pan-y;
  }
  .hero-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-text {
    position: relative; display: flex; flex-direction: column; align-items: center; gap: 20px;
    text-align: center; padding: 0 24px 0 160px; pointer-events: none;
  }
  .hero-name {
    font-family: var(--font-display); font-weight: 300; font-size: clamp(32px, 7vw, 56px);
    letter-spacing: var(--track-hero); line-height: 1.2; margin-right: calc(-1 * var(--track-hero));
  }
  .first { font-weight: 500; }
  .hero-cta {
    pointer-events: auto; margin-top: 24px; display: inline-flex; align-items: center; min-height: 48px; padding: 0 28px;
    border: 1.5px solid var(--text); background: rgba(245, 247, 252, .6); text-decoration: none; color: var(--text);
    font-family: var(--font-display); font-weight: 500; font-size: 14px; letter-spacing: var(--track-wide);
    transition: background-color .2s, color .2s;
  }
  .hero-cta:hover { background: var(--text); color: var(--bg); }
  @media (max-width: 760px) { .hero-text { padding: 0 24px; } }
  /* SNS アイコン：PC はサイドバーにあるのでスマホのみ表示 */
  .hero-sns { display: none; margin: 8px 0 0; padding: 0; list-style: none; gap: 8px; pointer-events: auto; }
  .hero-sns a { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--text); transition: color .2s; }
  .hero-sns a:hover { color: var(--accent-2); }
  @media (max-width: 760px) { .hero-sns { display: flex; } }
</style>

<script>
  import { HeroParticles } from '../scripts/particles';
  const hero = document.querySelector<HTMLElement>('#top');
  const canvas = hero?.querySelector<HTMLCanvasElement>('canvas');
  if (hero && canvas) {
    new HeroParticles(canvas, hero, { count: matchMedia('(max-width: 760px)').matches ? 360 : 720 });
  }
</script>
